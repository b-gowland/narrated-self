{
  "name": "narratedself-api",
  "private": true,
  "type": "module",
  "description": "Anonymous guess logging for The Narrated Self",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 execute narratedself --local --file schema.sql",
    "db:remote": "wrangler d1 execute narratedself --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
