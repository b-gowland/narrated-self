# Copy to .env and fill in yourself. Never commit .env or paste keys into chat.
# Default route: one OpenRouter key for every model.
OPENROUTER_API_KEY=

# Backup only: direct provider keys, used when a model's config says `via: direct`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
